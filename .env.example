# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins. Leave empty to disable CORS.
CORS_ORIGINS=http://localhost:5173
# Set to true when the app runs behind a reverse proxy (needed for correct client IPs / rate limiting)
TRUST_PROXY=false
# Expose Swagger UI at /api/docs
SWAGGER_ENABLED=true
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://app:app-password@localhost:27017/games_catalog?authSource=admin

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Optional. When both are set, an admin account is created on first boot if it does not exist.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---------------------------------------------------------------------------
# Docker compose (used by the mongo service)
# ---------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=app
MONGO_INITDB_ROOT_PASSWORD=app-password
